# Copy to .env and fill in. Never commit .env.

# OpenAI (personalization + reply classification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Hunter.io (contact discovery)
HUNTER_API_KEY=

# Email verification provider: "hunter" | "neverbounce" | "zerobounce"
EMAIL_VERIFY_PROVIDER=hunter
EMAIL_VERIFY_API_KEY=

# Gmail OAuth: path to the OAuth client file downloaded from Google Cloud Console
# (Desktop-app credentials). Token cache is written next to it as token.json.
GMAIL_CREDENTIALS_FILE=credentials.json

# Sending guardrails
DAILY_SEND_CAP=20

# Reply polling interval (minutes)
REPLY_POLL_MINUTES=15

# Nudge thresholds (business days)
NUDGE1_BUSINESS_DAYS=10
NUDGE2_BUSINESS_DAYS=20

# Database
DATABASE_URL=sqlite:///./applier.db
