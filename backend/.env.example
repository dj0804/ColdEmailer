# Copy to .env and fill in. Never commit .env.

# OpenAI (personalization + reply classification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_DRAFT_MODEL=gpt-5

# Hunter.io (contact discovery)
HUNTER_API_KEY=

# Email verification provider: "hunter" | "neverbounce" | "zerobounce"
EMAIL_VERIFY_PROVIDER=hunter
EMAIL_VERIFY_API_KEY=

# Candidate identity — injected into every generated email. Keep real values here
# (this file is a template; the real .env is gitignored) so personal contact
# details never get committed.
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKS=
CANDIDATE_SCHOOL=
CANDIDATE_YEAR=
CANDIDATE_PRIOR=
CANDIDATE_AVAILABILITY=

# Gmail OAuth: path to the OAuth client file downloaded from Google Cloud Console
# (Desktop-app credentials). Token cache is written next to it as token.json.
GMAIL_CREDENTIALS_FILE=credentials.json

# Sending guardrails
DAILY_SEND_CAP=20

# Reply polling interval (minutes)
REPLY_POLL_MINUTES=15

# Daily outreach routine (weekdays only). Stages drafts for approval — never sends.
OUTREACH_ENABLED=false
OUTREACH_PER_DAY=10
OUTREACH_HOUR=3

# Nudge thresholds (business days)
NUDGE1_BUSINESS_DAYS=10
NUDGE2_BUSINESS_DAYS=20
# Business days of total silence before an application is marked ghosted_dead
NUDGE_DEAD_BUSINESS_DAYS=30

# Database
DATABASE_URL=sqlite:///./applier.db
